    "After a few minutes the TV sleeps completely and only wakes with that setting on." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasados unos minutos el TV se duerme del todo y solo despierta con esa opción activada."
