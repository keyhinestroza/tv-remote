    "Control your smart TV over your home network. No internet and no original remote needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maneja tu smart TV por la red de tu casa. No hace falta internet ni el mando original."
          }
        }
      }
    },
    "Could not connect to the TV" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con el TV"
          }
        }
      }
    },
    "Could not find the TV on the network" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró el TV en la red"
