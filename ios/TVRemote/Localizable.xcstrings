    },
    "Search for your TV and the app fills in the address by itself; nothing to copy." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca tu TV y la app rellena sola la dirección; no tienes que copiar nada."
