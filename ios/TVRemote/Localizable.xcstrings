    "English" : {
      "extractionState" : "manual"
    },
    "Enter your TV's address to get started." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica la IP de tu TV para empezar."
          }
        }
      }
    },
    "Español" : {
      "extractionState" : "manual"
    },
    "Everything happens inside your network: the app talks to the TV directly and sends nothing to the internet. The TV's authorisation is kept in the iPhone's Keychain." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo ocurre dentro de tu red: la app le habla al TV directamente y no envía nada a internet. La autorización del TV se guarda en el Keychain del iPhone."
          }
        }
      }
    },
    "Find my TV" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buscar mi TV"
          }
        }
      }
    },
    "Forget authorisation" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvidar autorización"
          }
        }
      }
    },
    "Four things so the TV shows up first time." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuatro cosas para que el TV aparezca a la primera."
          }
        }
      }
    },
    "Fully switched off it does not answer, and the app cannot find it." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagado del todo no responde, y la app no puede encontrarlo."
          }
        }
      }
    },
    "Green: connected. Orange: connecting, or the TV is asleep. Red: no connection. Tap it to retry." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde: conectado. Naranja: conectando o el TV en reposo. Rojo: sin conexión. Tócalo para reintentar."
          }
        }
      }
    },
    "Help" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
