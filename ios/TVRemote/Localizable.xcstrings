      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vol −"
          }
        }
      }
    },
    "Volume" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volumen"
          }
        }
      }
    },
    "Why" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por qué"
          }
        }
      }
    },
    "With the system language the app follows the iPhone; any language other than Spanish or English shows in English." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el idioma del sistema la app sigue al iPhone; cualquier idioma que no sea español o inglés se ve en inglés."
          }
        }
      }
    },
    "Your remote, on the iPhone" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mando, en el iPhone"
          }
        }
      }
    },
    "Your television" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu televisor"
          }
        }
      }
    }
