    },
    "Swipe and tap" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza y toca"
          }
        }
      }
    },
    "Swipe to move · tap to select" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza para moverte · toca para seleccionar"
          }
        }
      }
    },
    "Swipe to move the focus through the TV menu and tap anywhere to select. The longer the swipe, the further it moves." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza para mover el foco por el menú del TV y toca en cualquier punto para seleccionar. Cuanto más largo el deslizamiento, más posiciones avanza."
          }
        }
      }
    },
    "Swipe to move the focus through the TV menu and tap to select." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza para mover el foco por el menú del TV y toca para seleccionar."
          }
        }
      }
    },
    "Swipe up or down to move, use the actions for the rest, and double tap to select" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza arriba o abajo para moverte, usa las acciones para el resto y toca dos veces para seleccionar"
          }
        }
      }
    },
    "System language" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idioma del sistema"
          }
        }
      }
    },
    "Tap the status to retry. If the TV changed address, the app finds it again by its MAC and switches over. If it stays that way, search for the TV again in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el estado para reintentar. Si el TV cambió de dirección, la app lo busca sola por su MAC y se cambia a la nueva. Si sigue igual, busca el TV otra vez en Ajustes."
          }
        }
      }
    },
    "Tap your TV to use it." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca tu TV para usarlo."
          }
        }
      }
    },
    "Television" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Televisor"
          }
        }
      }
    },
    "That means the authorisation could not be saved. Accept the prompt on the TV with its own remote; if it keeps happening, use “Forget authorisation” in Settings and connect again." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Significa que no se pudo guardar la autorización. Acepta el aviso en la pantalla del TV con su mando; si se repite, usa «Olvidar autorización» en Ajustes y vuelve a conectar."
          }
        }
      }
    },
    "That's it" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya está"
          }
        }
      }
    },
    "The big panel" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El panel grande"
          }
        }
      }
    },
    "The coloured dot" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El punto de color"
          }
        }
      }
    },
    "The first connection asks for permission on the TV screen: accept it with its own remote." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La primera conexión pide permiso en la pantalla del TV: acéptalo con su mando."
          }
        }
      }
    },
    "The iPhone and the TV on the same Wi-Fi. If your router has a guest network, do not use it." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPhone y el TV, en el mismo Wi-Fi. Si tu router tiene red de invitados, no la uses."
          }
        }
      }
    },
    "The iPhone talks to the TV directly; nothing goes out to the internet." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPhone le habla al TV directamente; nada sale a internet."
          }
        }
      }
    },
    "The iPhone's volume" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volumen del iPhone"
          }
        }
      }
    },
    "The iPhone's volume buttons raise and lower the TV's volume." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los botones de volumen del iPhone suben y bajan el del TV."
          }
        }
      }
    },
    "The MAC is only used to turn the TV on over the network." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La MAC solo se usa para encender el TV por Wake-on-LAN."
          }
        }
      }
    },
    "The MAC needs 12 hexadecimal digits." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La MAC debe tener 12 dígitos hexadecimales."
          }
        }
      }
    },
    "The red button. Just after switching off the TV answers at once; after a while the app wakes it over the network and it takes a few seconds." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón rojo. Si el TV lleva pocos segundos apagado responde al instante; si lleva más, la app lo despierta por la red y tarda unos segundos."
          }
        }
      }
    },
    "The same network" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma red"
          }
        }
      }
    },
    "The TV asks for permission every time" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV pide permiso cada vez"
          }
        }
      }
    },
    "The TV closed the connection" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV cerró la conexión"
          }
        }
      }
    },
    "The TV did not answer in time" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV no respondió a tiempo"
          }
        }
      }
    },
    "The TV did not authorise the connection" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV no autorizó la conexión"
          }
        }
      }
    },
    "The TV does not show up" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV no aparece al buscar"
          }
        }
      }
    },
    "The TV is off or not responding" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV está apagado o no responde"
          }
        }
      }
    },
    "The TV is refusing the connection. Is it on?" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV no acepta la conexión. ¿Está encendido?"
          }
        }
      }
    },
    "The TV moved to %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV cambió de dirección a %@"
          }
        }
      }
    },
    "The TV must be on and on the same Wi-Fi as the iPhone. Choosing it fills in the address and the MAC." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV tiene que estar encendido y en la misma red Wi-Fi que el iPhone. Al elegirlo se rellenan la IP y la MAC."
          }
        }
      }
    },
    "The TV needs this turned on: Settings › General › Network › Expert Settings › Power On with Mobile. And it has to stay plugged in and on the same network." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace falta activar en el televisor: Configuración › General › Red › Configuración experta › Encender con móvil. Y que el TV siga enchufado a la corriente y a la misma red."
          }
        }
      }
    },
    "The TV refused the connection. Accept the prompt on screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV rechazó la conexión. Acepta el permiso en pantalla."
          }
        }
      }
    },
    "The TV refused the encrypted connection" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El TV rechazó el cifrado de la conexión"
          }
        }
      }
    },
    "They just need to be on the same network." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta con que los dos estén en la misma red."
          }
        }
      }
    },
    "This iPhone is not on the TV's network" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPhone no está en la red del TV"
          }
        }
      }
    },
    "To turn the TV on after a while switched off, enable this once on the television." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para poder encender el TV cuando lleva rato apagado, actívalo una vez en el televisor."
          }
        }
      }
    },
    "Touch area" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Área táctil"
          }
        }
      }
    },
    "Turn it on before searching: fully switched off it does not answer. Check that the iPhone is on the same Wi-Fi, not the guest network. If your router splits the bands, use the same one as the TV." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enciéndelo antes de buscar: apagado del todo no responde. Comprueba que el iPhone esté en la misma red Wi-Fi, y no en la de invitados. Si tu router separa las bandas, conecta el iPhone a la misma que el TV."
          }
        }
      }
    },
    "Turn the TV on" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enciende el TV"
          }
        }
      }
    },
    "Turning the TV on and off" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encender y apagar"
          }
        }
      }
    },
    "Turns the TV on and off. Just switched off it answers at once; after a while it takes a few seconds." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enciende y apaga. Recién apagado responde al instante; si lleva un rato, tarda unos segundos."
          }
        }
      }
    },
    "TV asleep" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TV en reposo"
          }
        }
      }
    },
    "TV not found. Is it on?" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró el TV. ¿Está encendido?"
          }
        }
      }
    },
    "Type the address" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribir la IP a mano"
          }
        }
      }
    },
    "Up" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arriba"
          }
        }
      }
    },
    "Use the iPhone's own volume buttons while the app is open. They are in Options too." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se controla con los botones físicos del iPhone mientras la app está abierta. También están en Opciones."
          }
        }
      }
    },
    "Version" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versión"
          }
        }
      }
    },
    "Vol +" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vol +"
          }
        }
      }
    },
    "Vol −" : {
